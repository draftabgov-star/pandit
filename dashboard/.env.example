# Copy to `.env` or `.env.local` and fill in real values. Do not commit secrets.

# Prisma (SQLite example for local dev)
DATABASE_URL="file:./dev.db"

# NextAuth — use a long random string in production (e.g. openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# NowPayments
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Optional: full URL to livingface-widget.js on your CDN (no trailing slash)
WIDGET_CDN_URL=

# Optional: set to 1 only if you intentionally want /api/dev/widget outside development
ALLOW_WIDGET_PROXY=
