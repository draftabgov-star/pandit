# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets — never commit). `.env.example` is tracked on purpose.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# widget bundle intermediate output + generated static copy (keep public/widget/.gitkeep tracked)
/widget-lib/dist
/public/widget/livingface-widget.js

# prisma local database (never commit)
/prisma/dev.db
/prisma/dev.db-journal

# uploaded license orb assets (keep folder via .gitkeep)
/public/license-themes/*
!/public/license-themes/.gitkeep
